rules_version = '2';

// Avatar photos only, one per user, at avatars/{uid}. Anyone signed in can
// view any avatar (they're shown on the leaderboard/duel screens); only the
// owner can upload their own, capped at 5MB and images only.
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
