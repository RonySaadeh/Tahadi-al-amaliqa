rules_version = '2';

// Security model for this whole app, in one sentence: Cloud Functions run
// with the Admin SDK and bypass these rules entirely, so anything that must
// be trusted (scores, ELO, question answer keys, matchmaking) is written
// ONLY by a Cloud Function — every `allow write: if false` below is a
// collection whose real write path is `functions/src/**`, not a client.
// See each feature's README under `lib/features/*/README.md` for which
// function owns which collection.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isPlayerInDuel(duelId) {
      let duel = get(/databases/$(database)/documents/duels/$(duelId)).data;
      return request.auth.uid == duel.player1Id || request.auth.uid == duel.player2Id;
    }

    // --- users/{uid} ---
    // Anyone signed in can read any profile (leaderboard, opponent names,
    // duel history all need this). A user may create ONLY their own
    // profile document, and only with the fixed starting stats — this is
    // what stops someone from signing up with elo: 9999. Every stat field
    // after that (elo, wins, losses, streaks) is only ever changed by
    // `resolveDuel` in Cloud Functions.
    match /users/{uid} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.elo == 1200
        && request.resource.data.wins == 0
        && request.resource.data.losses == 0
        && request.resource.data.currentStreak == 0
        && request.resource.data.bestStreak == 0
        && request.resource.data.ownedCategoryIds.size() == 0
        // `displayNameLower` backs the case-insensitive prefix search in
        // `FriendsRepository.searchUsers` — kept honest here so a client
        // can't index itself under a name it doesn't actually have.
        && request.resource.data.displayNameLower == request.resource.data.displayName.lower();

      allow update: if isSignedIn()
        && request.auth.uid == uid
        && (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'displayNameLower', 'photoUrl', 'locale'])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName', 'displayNameLower'])
            || request.resource.data.displayNameLower == request.resource.data.displayName.lower()
          )
          // Presence heartbeat: its own narrow path, separate from the
          // profile-edit path above, and only ever the server's own clock —
          // `== request.time` stops a client from writing an arbitrary
          // (e.g. future) timestamp to fake "online" status.
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt'])
            && request.resource.data.lastActiveAt == request.time
          )
          // One-time self-heal for an account created before `playerId`
          // existed (see `UserModel.legacyBackfillFields`): only writable
          // while `playerId` is still absent, so this path closes itself
          // after the first successful write.
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerId', 'displayNameLower'])
            && !('playerId' in resource.data)
            && request.resource.data.playerId is string
            && request.resource.data.playerId.size() > 0
            && request.resource.data.displayNameLower == resource.data.displayName.lower()
          )
        );

      allow delete: if false;
    }

    // --- categoryGroups/{groupId} ---
    // The section headers the category picker groups categories under
    // (Sports, Movies & TV, ...). Client-read-only, seeded once by
    // functions/src/seed/seedCategoryTaxonomy.ts — there's no in-app way to
    // create a group, only categories within the existing ones (home-turf
    // categories don't belong to a group at all; see `groupId: null` in
    // functions/src/questions/homeTurf.ts).
    match /categoryGroups/{groupId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // --- categories/{categoryId} ---
    // Client-read-only. Created by `createHomeTurfCategory` (which also
    // enforces the 3-per-owner cap — see functions/src/questions/homeTurf.ts)
    // or by the `seedCategoryTaxonomy` admin script for the global taxonomy.
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // --- questions/{questionId} ---
    // Client-read-only. If a client could write here, anyone could plant a
    // question with a wrong "correct" answer to guarantee a win. Written by
    // `addHomeTurfQuestion` and the `functions/src/seed` scripts.
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // --- duels/{duelId} + rounds + answers ---
    // Only the two players in a duel can even read its document — everyone
    // else gets nothing. `rounds/{n}` intentionally never contains the
    // correct answer or either player's pick until it's resolved (see
    // `RoundDoc` in functions/src/lib/types.ts), and the raw `answers`
    // subcollection is blocked from clients entirely, even for reading —
    // otherwise a player could peek at Firestore and read their opponent's
    // submitted answer before submitting their own.
    match /duels/{duelId} {
      // Checks `participantIds` (== `[player1Id, player2Id]`) rather than
      // ORing `player1Id`/`player2Id` directly: Firestore refuses a `list`
      // query against a rule that ORs two different `resource.data` fields
      // when the query itself only filters one of them — it can't prove
      // every possible result satisfies the untested field. A single array
      // membership check against a query that filters the *same* field
      // (`array-contains`) is provably safe, so this is what
      // `watchRecentDuelsFor` in `duel_repository.dart` queries against.
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow write: if false;

      match /rounds/{roundNumber} {
        allow read: if isSignedIn() && isPlayerInDuel(duelId);
        allow write: if false;

        match /answers/{uid} {
          allow read, write: if false;
        }
      }
    }

    // --- duelInvites/{inviteId} ---
    // Only the sender and recipient can see a challenge. Created by
    // `sendDuelChallenge`, resolved by `respondToDuelChallenge`.
    match /duelInvites/{inviteId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId);
      allow write: if false;
    }

    // --- openLobbies/{lobbyId} ---
    // The quick-match queue. Readable so a future version of the client can
    // watch its own queue entry for a match; entries are only ever created/
    // updated/deleted by `joinOpenLobby`/`leaveOpenLobby`.
    match /openLobbies/{lobbyId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // --- leaderboardPairings/{pairingId} ---
    // Head-to-head records. Written only as a side effect of `resolveDuel`.
    match /leaderboardPairings/{pairingId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // --- friendships/{pairingId} ---
    // One doc per pair, keyed the same deterministic sorted-uid way as
    // `leaderboardPairings` (see `FirestorePaths.pairingId`) — that's what
    // stops a duplicate friend request or a duplicate friendship from ever
    // existing. `status` moves pending -> accepted/declined; a decline can
    // be re-requested later, which just resets this same doc. Only the two
    // people in the pair can read it. Written only by
    // `sendFriendRequest`/`respondToFriendRequest`.
    match /friendships/{pairingId} {
      // Same `participantIds` array-membership trick as `duels` above, and
      // for the same reason — this used to OR `fromUserId`/`toUserId`
      // directly, which Firestore silently refuses for a `list` query that
      // only filters one of those two fields.
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow write: if false;
    }

    // --- notifications/{notificationId} ---
    // A user's in-app inbox (friend requests, challenges). Created only by
    // Cloud Functions (`sendFriendRequest`, `sendDuelChallenge`) as a side
    // effect of the real action — never directly. The one thing a client
    // legitimately owns here is dismissing its own unread badge, so `read`
    // gets a narrow client-writable exception the same way a duel's
    // presence heartbeat does on `users/{uid}` above.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }
  }
}
